#!/bin/sh
# Create the service account and its state directory, then hand over to
# systemd. Idempotent throughout: postinst runs again on every upgrade, and a
# script that only works on a clean machine is a script that breaks upgrades.
#
# The systemd calls are written out rather than left to a #DEBHELPER# token,
# because this package is assembled with dpkg-deb and nothing would ever
# substitute that token -- it would sit here looking like it did something.
set -e

USER=hamhill
STATE=/var/lib/hammunition-hill
UNIT=hammunition-hill.service

case "$1" in
  configure)
    if ! getent passwd "$USER" >/dev/null; then
      adduser --system --group --no-create-home \
              --home "$STATE" \
              --gecos "Hammunition Hill dashboard" \
              "$USER" >/dev/null
    fi
    mkdir -p "$STATE"
    chown "$USER":"$USER" "$STATE"
    # The config can carry a lookup API key and always carries a callsign; it
    # is not for every account on the machine to read.
    if [ -f /etc/hammunition-hill/config.toml ]; then
      chown root:"$USER" /etc/hammunition-hill/config.toml
      chmod 0640 /etc/hammunition-hill/config.toml
    fi

    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload >/dev/null 2>&1 || true
      [ -x /usr/bin/deb-systemd-helper ] && \
        deb-systemd-helper unmask "$UNIT" >/dev/null 2>&1 || true

      # "$2" is the previously configured version, empty on a first install.
      # That is the distinction that matters here, and it is spelled out
      # rather than inferred from deb-systemd-helper's was-enabled, which
      # answers differently on different distributions: the first version of
      # this script asked was-enabled, got "no" on Kali where Debian said
      # "yes", and shipped a package that installed a service it never
      # enabled or started. The unit was fine; nothing had turned it on.
      if [ -z "$2" ]; then
        # First install: enable and start, as a service package should.
        systemctl enable "$UNIT" >/dev/null 2>&1 || true
        systemctl start "$UNIT" >/dev/null 2>&1 || true
      else
        # Upgrade: restart it only if it is already running. An operator who
        # stopped or disabled this deliberately does not want an upgrade to
        # override that decision.
        systemctl try-restart "$UNIT" >/dev/null 2>&1 || true
      fi
    fi
    ;;
  abort-upgrade|abort-remove|abort-deconfigure)
    ;;
esac

exit 0
